# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Provider -----------------------------------------------------------
# openai = pay-per-token API (NOT the free ChatGPT tier)
# ollama = local models, no key, no cost
SCRAPER_PROVIDER=openai

# --- OpenAI -------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Ollama (local) -----------------------------------------------------
# Requires: ollama serve  +  ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# --- Fetching -----------------------------------------------------------
REQUEST_TIMEOUT=30
RENDER_TIMEOUT=45
RESPECT_ROBOTS=true
POLITENESS_DELAY=0.5

# --- Cost control -------------------------------------------------------
# Characters of page content per LLM call (~4 chars per token).
MAX_CHUNK_CHARS=12000
CHUNK_OVERLAP_CHARS=400
# Hard cap on LLM calls per page.
MAX_CHUNKS=12
